---
import { contentAvailability, labels, localeNames, type Locale } from '../lib/content';

interface Props { locale: Locale; displayLocale?: Locale; headingLevel?: 2 | 3; }
const { locale, displayLocale = locale, headingLevel = 2 } = Astro.props;
const t = labels(displayLocale);
const counts = contentAvailability(locale);
const format = new Intl.NumberFormat(displayLocale);
---
<section aria-label={`${t.availability}: ${localeNames[locale]}`} class="py-2">
  {headingLevel === 2
    ? <h2 class="mt-0 mb-2 text-base" lang={locale}>{localeNames[locale]}</h2>
    : <h3 class="mb-2 font-semibold text-foreground" lang={locale}>{localeNames[locale]}</h3>}
  <ul class="m-0 list-none p-0 text-sm">
    <li class="flex flex-wrap justify-between gap-x-3 py-1"><span>{t.translation}</span><span class="tabular-nums">{format.format(counts.surahs)} / {format.format(counts.totalSurahs)} {t.surahs}</span></li>
    <li class="flex flex-wrap justify-between gap-x-3 py-1"><span>{t.tafsir}</span><span class="tabular-nums">{format.format(counts.commentary)} / {format.format(counts.totalSurahs)} {t.surahs}</span></li>
    <li class="flex flex-wrap justify-between gap-x-3 py-1"><span>{t.prayers}</span><span class="tabular-nums">{format.format(counts.prayers)} / {format.format(counts.totalPrayers)}</span></li>
  </ul>
</section>

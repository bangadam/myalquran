---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, labels, surahDirectory, type Locale } from '../../lib/content';
import { interfaceLabels } from '../../lib/interface-labels';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = labels(locale), ui = interfaceLabels[locale];
---
<BaseLayout title={t.saved} locale={locale}>
  <p class="intro">{ui.stored}</p>
  <section data-library data-locale={locale} data-verse-label={t.verse} data-unavailable={t.savedUnavailable} data-remove-label={t.removeVerse} data-open-label={ui.openVerse} data-surah-catalog={JSON.stringify(surahDirectory(locale).map(s => ({ number: s.number, title: s.latin, count: s.count })))}>
    <p data-saved-empty role="status">{t.savedEmpty}</p>
    <ol data-saved-list class="saved-list"></ol>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, labels, localeNames, type Locale } from '../../lib/content';
import { interfaceLabels } from '../../lib/interface-labels';
import { Check } from 'lucide-react';
import ContentAvailability from '../../components/ContentAvailability.astro';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = labels(locale), ui = interfaceLabels[locale];
---
<BaseLayout title={t.language} locale={locale}>
  <p class="intro">{ui.languageHelp}</p>
  <ul class="prayer-list">{locales.map(language => <li><a href={`/${language}/`} lang={language} data-language-link data-locale-choice={language}>{localeNames[language]}{language === locale && <Check size={20} aria-hidden="true" />}</a></li>)}</ul>
  <aside class="availability"><h2 class="mt-0">{t.availability}</h2>{locales.map(language => <ContentAvailability locale={language} displayLocale={locale} headingLevel={3} />)}</aside>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, labels, localeNames, translationSource, commentarySource, type Locale } from '../../lib/content';
import TranslationCredit from '../../components/TranslationCredit.astro';
import ContentAvailability from '../../components/ContentAvailability.astro';

export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = labels(locale);
---
<BaseLayout title={t.aboutTitle} locale={locale} section="about">
  <header class="border-b border-[var(--divider)] pb-5 mb-6">
    <p class="eyebrow">MyAlQuran</p>
    <p class="intro mb-0">{t.aboutText}</p>
  </header>

  <section aria-labelledby="availability-heading" class="mt-8">
    <h2 id="availability-heading">{t.availability}</h2>
    <ContentAvailability locale={locale} headingLevel={3} />
  </section>

  <section aria-labelledby="translation-heading" class="mt-8">
    <h2 id="translation-heading">{t.translation}</h2>
    {locales.map(language => { const source = translationSource(language); return source && <div class="mb-5"><p class="eyebrow" lang={language}>{localeNames[language]}</p><TranslationCredit source={source} /></div>; })}
  </section>

  <section aria-labelledby="tafsir-heading" class="mt-8">
    <h2 id="tafsir-heading">{t.tafsir}</h2>
    {locales.map(language => { const source = commentarySource(language); return source && <div class="mb-5"><p class="eyebrow" lang={language}>{localeNames[language]}</p><TranslationCredit source={source} /></div>; })}
  </section>

  <section class="border-t border-[var(--divider)] pt-5 mt-8">
    <p class="metadata">{t.updateDate}</p>
    <aside class="availability">{t.rights}</aside>
    <a class="text-link" href={`/${locale}/offline/`}>{t.offlineTitle} →</a>
  </section>
</BaseLayout>

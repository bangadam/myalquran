---
import { labels, locales, localeNames } from '../lib/content';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>Offline · MyAlQuran</title>
    <style is:inline>
      :root { color-scheme:light; --outer:#f2f4f2; --paper:#ffffff; --ink:#171717; --green:#1e5546; --muted:#626966; --line:#e3e7e5; --soft:#e7eeeb; }
      @media (prefers-color-scheme:dark) { :root { color-scheme:dark; --outer:#101512; --paper:#171c19; --ink:#edf2ef; --green:#9bd1b9; --muted:#aab8b0; --line:#3a4a41; --soft:#283e34; } }
      *, *::before, *::after { box-sizing:border-box; }
      body { margin:0; background:var(--outer); color:var(--ink); font:1rem/1.65 system-ui,-apple-system,"Segoe UI",sans-serif; }
      .shell { width:100%; max-width:480px; min-height:100vh; min-height:100svh; margin-inline:auto; background:var(--paper); display:flex; flex-direction:column; }
      .site-header { display:flex; align-items:center; gap:11px; padding:20px 28px; border-bottom:1px solid var(--line); }
      .brand { font:21px/1.5 Georgia,serif; }
      .status { margin-left:auto; color:var(--green); font-size:.73rem; font-weight:750; letter-spacing:.12em; white-space:nowrap; }
      main { flex:1; padding:40px 28px 44px; }
      .lead { padding-bottom:26px; }
      .eyebrow { margin:0 0 5px; color:var(--green); font-size:.72rem; font-weight:750; letter-spacing:.13em; text-transform:uppercase; }
      h1 { margin:0; font:500 36px/1.2 Georgia,serif; }
      .lead p:last-child { margin:10px 0 0; color:var(--muted); font-size:1.05rem; }
      .list-heading { margin:0; padding:14px 0 12px; border-top:2px solid var(--green); color:var(--muted); font-size:.75rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
      section { display:grid; grid-template-columns:28px minmax(0,1fr); gap:14px; padding:20px 0 22px; border-top:1px solid var(--line); }
      .number { padding-top:2px; color:var(--green); font-size:.76rem; font-weight:700; font-variant-numeric:tabular-nums; }
      .language { margin:0 0 2px; color:var(--muted); font-size:.78rem; }
      h2 { margin:0 0 6px; font-size:1.15rem; line-height:1.4; letter-spacing:-.025em; }
      a { display:inline-flex; align-items:center; min-height:44px; gap:8px; color:var(--green); font-size:.88rem; font-weight:650; text-decoration:underline; text-underline-offset:4px; transition:background-color .18s ease; }
      a:hover { background:var(--soft); }
      :focus-visible { outline:2px solid var(--green); outline-offset:3px; }
      @media (prefers-reduced-motion:reduce) { a { transition:none; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="brand">MyAlQuran</div>
        <span class="status">503</span>
      </header>
      <main>
        <div class="lead">
          <p class="eyebrow">MyAlQuran / {labels('id').offline}</p>
          <h1 aria-label={`503 · ${labels('id').notCached}`}>503</h1>
          <p>{labels('id').notCached}</p>
        </div>
        <p class="list-heading">{labels('id').language}</p>
        {locales.map((locale, index) => (
          <section lang={locale} aria-label={localeNames[locale]}>
            <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="language">{localeNames[locale]}</p>
              <h2>{labels(locale).notCached}</h2>
              <a href={`/${locale}/`}>{labels(locale).backReading} <span aria-hidden="true">→</span></a>
            </div>
          </section>
        ))}
      </main>
    </div>
  </body>
</html>
